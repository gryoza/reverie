[Unit]
Description=SteamDeck Plugin Loader
After=local-fs.target

[Service]
Type=simple
User=root
Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=8
ExecStart=/usr/bin/box64 /home/steamos/homebrew/services/PluginLoader
WorkingDirectory=/home/steamos/homebrew/services
Environment=UNPRIVILEGED_PATH=/home/steamos/homebrew
Environment=PRIVILEGED_PATH=/home/steamos/homebrew
Environment=LOG_LEVEL=INFO
Environment=HOME=/home/steamos
Environment=USER=steamos
Environment=XDG_CONFIG_HOME=/home/steamos/.config
Environment=XDG_DATA_HOME=/home/steamos/.local/share
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=BOX64_NOBANNER=1

[Install]
WantedBy=multi-user.target
