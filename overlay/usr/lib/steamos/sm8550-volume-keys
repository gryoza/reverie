#!/usr/bin/env python3
"""SM8550 volume rocker watcher for AYANEO Pocket S and AYN Odin 2.
Maps gpio-keys and pmic_resin to wpctl / pactl volume changes.
On AYANEO Pocket S, the physical '+' button emits KEY_VOLUMEDOWN and '-' emits KEY_VOLUMEUP.
We invert the mapping so '+' increases volume and '-' decreases volume.
"""
from __future__ import annotations

import array
import fcntl
import glob
import os
import select
import struct
import subprocess
import sys
import time

EVENT_FMT = "llHHi"
EVENT_SIZE = struct.calcsize(EVENT_FMT)
EV_KEY = 0x01
KEY_MUTE = 113
KEY_VOLUMEDOWN = 114
KEY_VOLUMEUP = 115
STEP = os.environ.get("SM8550_VOLUME_STEP", "5%")
LIMIT = os.environ.get("SM8550_VOLUME_LIMIT", "1.0")
ALLOW = ("gpio-keys", "pmic_resin")


def log(msg: str) -> None:
    print(f"sm8550-volume-keys: {msg}", flush=True)


def wpctl(*args: str) -> bool:
    env = os.environ.copy()
    if "XDG_RUNTIME_DIR" not in env:
        env["XDG_RUNTIME_DIR"] = f"/run/user/{os.getuid()}"
    try:
        res = subprocess.run(
            ["wpctl", *args],
            capture_output=True,
            text=True,
            timeout=2,
            env=env,
        )
        if res.returncode == 0:
            log(f"wpctl {' '.join(args)} -> OK")
            return True
        else:
            log(f"wpctl {' '.join(args)}: {res.stderr.strip()}")
            return False
    except Exception as exc:
        log(f"wpctl exception: {exc}")
        return False


def pactl(*args: str) -> bool:
    env = os.environ.copy()
    if "XDG_RUNTIME_DIR" not in env:
        env["XDG_RUNTIME_DIR"] = f"/run/user/{os.getuid()}"
    try:
        res = subprocess.run(
            ["pactl", *args],
            capture_output=True,
            text=True,
            timeout=2,
            env=env,
        )
        return res.returncode == 0
    except Exception:
        return False


def device_name(path: str) -> str:
    name = os.path.basename(path)
    sysname = f"/sys/class/input/{name}/device/name"
    try:
        return open(sysname, encoding="utf-8", errors="ignore").read().strip()
    except OSError:
        return ""


def has_volume_keys(fd: int) -> bool:
    buf = array.array("B", [0] * 96)
    nr = 0x20 + EV_KEY
    ioc = (2 << 30) | (ord("E") << 8) | nr | (len(buf) << 16)
    try:
        fcntl.ioctl(fd, ioc, buf, True)
    except OSError:
        return False

    def bit(code: int) -> bool:
        return bool(buf[code // 8] & (1 << (code % 8)))

    return bit(KEY_VOLUMEUP) or bit(KEY_VOLUMEDOWN) or bit(KEY_MUTE)


def open_devices() -> list[tuple[str, int]]:
    opened: list[tuple[str, int]] = []
    for path in sorted(glob.glob("/dev/input/event*")):
        dname = device_name(path).lower()
        if not any(a in dname for a in ALLOW):
            continue
        try:
            fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
        except OSError as exc:
            log(f"cannot open {path} ({dname}): {exc}")
            continue
        if not has_volume_keys(fd):
            os.close(fd)
            continue
        log(f"watching volume device {path} ({dname})")
        opened.append((path, fd))
    return opened


def apply(code: int) -> None:
    # Inverted physical rocker on Pocket S:
    # KEY_VOLUMEUP is physical '-', KEY_VOLUMEDOWN is physical '+'
    if code == KEY_VOLUMEUP:
        log("KEY_VOLUMEUP (physical '-') -> volume -5%")
        if not wpctl("set-volume", "-l", LIMIT, "@DEFAULT_AUDIO_SINK@", f"{STEP}-"):
            if not wpctl("set-volume", "-l", LIMIT, "@DEFAULT_SINK@", f"{STEP}-"):
                pactl("set-sink-volume", "@DEFAULT_SINK@", f"-{STEP}")
    elif code == KEY_VOLUMEDOWN:
        log("KEY_VOLUMEDOWN (physical '+') -> volume +5%")
        if not wpctl("set-volume", "-l", LIMIT, "@DEFAULT_AUDIO_SINK@", f"{STEP}+"):
            if not wpctl("set-volume", "-l", LIMIT, "@DEFAULT_SINK@", f"{STEP}+"):
                pactl("set-sink-volume", "@DEFAULT_SINK@", f"+{STEP}")
    elif code == KEY_MUTE:
        log("MUTE")
        if not wpctl("set-mute", "@DEFAULT_AUDIO_SINK@", "toggle"):
            if not wpctl("set-mute", "@DEFAULT_SINK@", "toggle"):
                pactl("set-sink-mute", "@DEFAULT_SINK@", "toggle")


def main() -> int:
    log("starting sm8550-volume-keys listener")
    devs: list[tuple[str, int]] = []
    for _ in range(30):
        devs = open_devices()
        if devs:
            break
        time.sleep(1.0)

    fds = {fd: path for path, fd in devs}
    while True:
        if not fds:
            time.sleep(2.0)
            devs = open_devices()
            fds = {fd: path for path, fd in devs}
            continue
        try:
            ready, _, _ = select.select(list(fds), [], [], 2.0)
        except InterruptedError:
            continue
        for fd in ready:
            try:
                data = os.read(fd, EVENT_SIZE * 8)
            except OSError:
                continue
            for off in range(0, len(data) - EVENT_SIZE + 1, EVENT_SIZE):
                _s, _us, etype, code, value = struct.unpack_from(EVENT_FMT, data, off)
                if etype == EV_KEY and value == 1:
                    apply(code)
    return 0


if __name__ == "__main__":
    sys.exit(main())
