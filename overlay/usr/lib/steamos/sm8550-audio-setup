#!/bin/bash
# Bring up SM8550 playback clocks and mixers.
# Supports both AYANEO Pocket S (WSA884x) and AYN Odin 2 (AW88166/MI2S).
set +e
export PATH="/usr/sbin:/usr/bin:/sbin:/bin${PATH:+:$PATH}"

if [[ -f /etc/reverie/debug-enabled ]]; then
  LOGFILE="/home/steamos/sm8550-audio-setup.log"
else
  LOGFILE="/dev/null"
fi
log() {
  echo "sm8550-audio-setup: $*" >&2
  echo "$(date '+%Y-%m-%d %H:%M:%S') sm8550-audio-setup: $*" >>"$LOGFILE" 2>/dev/null || true
}

if [[ -d /usr/share/alsa/ucm2/AYANEO ]]; then
  find /usr/share/alsa/ucm2/AYANEO /usr/share/alsa/ucm2/conf.d/sm8550 \
    /usr/share/alsa/ucm2/codecs /usr/share/alsa/ucm2/lib \
    -type d -exec chmod 0755 {} + 2>/dev/null
  find /usr/share/alsa/ucm2/AYANEO /usr/share/alsa/ucm2/conf.d/sm8550 \
    /usr/share/alsa/ucm2/codecs /usr/share/alsa/ucm2/lib \
    -type f -exec chmod 0644 {} + 2>/dev/null
fi

wait_card() {
  local i
  for i in $(seq 1 120); do
    if [[ -e /dev/snd/controlC0 ]] || ([[ -d /proc/asound/card0 ]] && ! grep -qi "no soundcards" /proc/asound/cards 2>/dev/null); then
      log "card0 detected at iteration $i ($(tr '\n' ' ' </proc/asound/cards 2>/dev/null))"
      return 0
    fi
    sleep 0.25
  done
  return 1
}

if ! wait_card; then
  log "no ASoC card yet after 30s"
  cat /proc/asound/cards >&2 || true
  exit 0
fi

# Allow ALSA controls to settle
sleep 0.5

card_id="0"
card_name="$(awk '/^[[:space:]]*0[[:space:]]+/{print $2; exit}' /proc/asound/cards)"
log "using card ${card_id} (${card_name})"

# AYANEO Pocket S / WSA884x:
if grep -qiE 'SM8550-APS|ayaneo' /proc/asound/cards 2>/dev/null || [[ -d /usr/share/alsa/ucm2/AYANEO ]]; then
  log "Configuring AYANEO Pocket S WSA884x speaker amplifier..."

  if command -v alsaucm >/dev/null 2>&1; then
    alsaucm -c SM8550-APS set _verb HiFi set _enadev Speaker >>"$LOGFILE" 2>&1 || true
    alsaucm -c "hw:${card_id}" set _verb HiFi set _enadev Speaker >>"$LOGFILE" 2>&1 || true
  fi

  # Route both MultiMedia1 and MultiMedia2 to WSA codec DMA RX:
  amixer -c "$card_id" cset name='WSA_CODEC_DMA_RX_0 Audio Mixer MultiMedia1' 1 >>"$LOGFILE" 2>&1 || true
  amixer -c "$card_id" cset name='WSA_CODEC_DMA_RX_0 Audio Mixer MultiMedia2' 1 >>"$LOGFILE" 2>&1 || true
  amixer -c "$card_id" cset name='DISPLAY_PORT_RX_0 Audio Mixer MultiMedia1' 0 >>"$LOGFILE" 2>&1 || true
  amixer -c "$card_id" cset name='DISPLAY_PORT_RX_0 Audio Mixer MultiMedia2' 0 >>"$LOGFILE" 2>&1 || true
  amixer -c "$card_id" cset name='MultiMedia3 Mixer VA_CODEC_DMA_TX_0' 1 >>"$LOGFILE" 2>&1 || true
  amixer -c "$card_id" cset name='WSA RX0 MUX' AIF1_PB >>"$LOGFILE" 2>&1 || true
  amixer -c "$card_id" cset name='WSA RX1 MUX' AIF1_PB >>"$LOGFILE" 2>&1 || true
  amixer -c "$card_id" cset name='WSA_RX0 INP0' RX0 >>"$LOGFILE" 2>&1 || true
  amixer -c "$card_id" cset name='WSA_RX1 INP0' RX1 >>"$LOGFILE" 2>&1 || true
  amixer -c "$card_id" cset name='WSA_COMP1 Switch' 0 >>"$LOGFILE" 2>&1 || true
  amixer -c "$card_id" cset name='WSA_COMP2 Switch' 0 >>"$LOGFILE" 2>&1 || true
  amixer -c "$card_id" cset name='SpkrLeft COMP Switch' 0 >>"$LOGFILE" 2>&1 || true
  amixer -c "$card_id" cset name='SpkrLeft BOOST Switch' 1 >>"$LOGFILE" 2>&1 || true
  amixer -c "$card_id" cset name='SpkrLeft DAC Switch' 1 >>"$LOGFILE" 2>&1 || true
  amixer -c "$card_id" cset name='SpkrLeft PBR Switch' 0 >>"$LOGFILE" 2>&1 || true
  amixer -c "$card_id" cset name='SpkrLeft VISENSE Switch' 0 >>"$LOGFILE" 2>&1 || true
  amixer -c "$card_id" cset name='SpkrLeft WSA MODE' 0 >>"$LOGFILE" 2>&1 || true
  amixer -c "$card_id" cset name='SpkrLeft PA Volume' 17 >>"$LOGFILE" 2>&1 || true
  amixer -c "$card_id" cset name='SpkrRight COMP Switch' 0 >>"$LOGFILE" 2>&1 || true
  amixer -c "$card_id" cset name='SpkrRight BOOST Switch' 1 >>"$LOGFILE" 2>&1 || true
  amixer -c "$card_id" cset name='SpkrRight DAC Switch' 1 >>"$LOGFILE" 2>&1 || true
  amixer -c "$card_id" cset name='SpkrRight PBR Switch' 0 >>"$LOGFILE" 2>&1 || true
  amixer -c "$card_id" cset name='SpkrRight VISENSE Switch' 0 >>"$LOGFILE" 2>&1 || true
  amixer -c "$card_id" cset name='SpkrRight WSA MODE' 0 >>"$LOGFILE" 2>&1 || true
  amixer -c "$card_id" cset name='SpkrRight PA Volume' 17 >>"$LOGFILE" 2>&1 || true
  amixer -c "$card_id" cset name='WSA_RX0 Digital Volume' 84 >>"$LOGFILE" 2>&1 || true
  amixer -c "$card_id" cset name='WSA_RX1 Digital Volume' 84 >>"$LOGFILE" 2>&1 || true
  log "AYANEO Pocket S speaker mixers applied successfully"
else
  log "Configuring AYN Odin 2 mixers..."
  if command -v alsaucm >/dev/null 2>&1; then
    alsaucm -c AYN-Odin2 set _verb HiFi set _enadev Speaker >>"$LOGFILE" 2>&1 || true
    alsaucm -c "hw:${card_id}" set _verb HiFi set _enadev Speaker >>"$LOGFILE" 2>&1 || true
  fi
  amixer -c "$card_id" cset name='PRIMARY_MI2S_RX Audio Mixer MultiMedia1' 1 >>"$LOGFILE" 2>&1 || true
  amixer -c "$card_id" cset name='RX_CODEC_DMA_RX_0 Audio Mixer MultiMedia2' 1 >>"$LOGFILE" 2>&1 || true
  amixer -c "$card_id" cset name='DISPLAY_PORT_RX_0 Audio Mixer MultiMedia2' 0 >>"$LOGFILE" 2>&1 || true
  amixer -c "$card_id" cset name='RX_RX0 Digital Volume' 84 >>"$LOGFILE" 2>&1 || true
  amixer -c "$card_id" cset name='RX_RX1 Digital Volume' 84 >>"$LOGFILE" 2>&1 || true
  log "Odin2 speaker mixers applied"
fi

chown 1000:1000 "$LOGFILE" 2>/dev/null || true
exit 0
